APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=80
APP_VUE_PORT=3000
VIDEOS_DIR=/Volumes/plex/videos
DATA_DIR=./data
SCAN_INTERVAL_MS=300000
QSV_DEVICE=/dev/dri/renderD128

# Production authentication and session controls
# SESSION_SECRET=replace-with-at-least-32-random-characters
# AUTH_SETUP_TOKEN=replace-with-at-least-16-random-characters
# SESSION_IDLE_TIMEOUT_MS=604800000
# SESSION_ABSOLUTE_TIMEOUT_MS=2592000000
# LOGIN_WINDOW_MS=900000
# LOGIN_MAX_ATTEMPTS=5
# Comma-separated IP addresses/CIDRs of trusted reverse proxies; empty trusts none.
# TRUSTED_PROXIES=
